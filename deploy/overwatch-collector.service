[Unit]
Description=Overwatch AIO bounded due-job collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=overwatch
WorkingDirectory=/opt/overwatch-aio-mcp
Environment=OW_DB_PATH=/var/lib/overwatch-mcp/overwatch.db
Environment=UV_CACHE_DIR=/var/cache/overwatch-mcp
StateDirectory=overwatch-mcp
CacheDirectory=overwatch-mcp
ExecStart=/usr/local/bin/uv run --frozen --no-sync overwatch-aio-mcp collect --config /opt/overwatch-aio-mcp/examples/collector.json --once
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/overwatch-mcp /var/cache/overwatch-mcp
TimeoutStartSec=35min
MemoryMax=768M
