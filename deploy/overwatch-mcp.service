[Unit]
Description=Overwatch AIO MCP (loopback HTTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=overwatch
WorkingDirectory=/opt/overwatch-aio-mcp
Environment=OW_DB_PATH=/var/lib/overwatch-mcp/overwatch.db
Environment=UV_CACHE_DIR=/var/cache/overwatch-mcp
StateDirectory=overwatch-mcp
CacheDirectory=overwatch-mcp
ExecStart=/usr/local/bin/uv run --frozen --no-sync overwatch-aio-mcp serve --transport streamable-http --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/overwatch-mcp /var/cache/overwatch-mcp
MemoryMax=768M

[Install]
WantedBy=multi-user.target
